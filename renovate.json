{
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":semanticCommits"
  ],
  "reviewers": [
    "AlexProgrammerDE"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Native Cargo digest updates follow upstream master and would drop the fork fixes. The custom manager tracks v0.20.x instead.",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "groupName": "WebRTC fork maintenance",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^native/Cargo\\.toml$/"
      ],
      "matchStrings": [
        "(?<depName>rtc|ice|webrtc) = \\{[^\\n]*git = \"(?<packageName>https://github\\.com/enderdash-com/[^\"\\n]+)\"[^\\n]*rev = \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "currentValueTemplate": "v0.20.x",
      "datasourceTemplate": "git-refs"
    }
  ]
}
